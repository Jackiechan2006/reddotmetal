# Supabase (PostgreSQL database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend (email delivery)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Admin panel credentials
ADMIN_EMAIL=admin@reddotmetal.com
ADMIN_PASSWORD=admin123

# WhatsApp number (international format, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=9876543210

# Phone number displayed on site
NEXT_PUBLIC_PHONE_NUMBER=+1234567890

# Google Maps API key (optional, for embedded maps)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
