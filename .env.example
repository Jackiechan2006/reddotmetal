# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here   # NEVER expose to frontend

# ─── Resend (Email) ───────────────────────────────────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
FROM_EMAIL=noreply@yourdomain.com         # Must be a verified domain in Resend
ADMIN_EMAIL=hanushree20@gmail.com         # Admin notification recipient

# ─── Node ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
